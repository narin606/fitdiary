# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://api.example.com

# Backend (Ubuntu)
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://example.com
DATABASE_URL=postgresql://fitdiary:change-me@localhost:5432/fitdiary
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_DOMAIN=.example.com

# S3-compatible photo storage (Cloudflare R2, AWS S3, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=fitdiary
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# OpenAI-compatible vision API (only called after the user presses Analyze)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_VISION_MODEL=gpt-4.1-mini

